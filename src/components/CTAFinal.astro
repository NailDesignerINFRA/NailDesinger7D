---
import Decor from "./Decor.astro";
---

<section class="relative isolate overflow-hidden py-28 lg:py-40">
  <!-- Cinematic dark luxury -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-br from-[#2A2118] via-[#5C4A30] to-[#3F3424]"></div>
    <div class="absolute inset-0 bg-gradient-to-tr from-[#C9A961]/10 via-transparent to-[#F4E4C1]/15"></div>

    <div class="orb floaty-slow" style="width: 700px; height: 700px; top: -200px; right: -200px; background: radial-gradient(circle, rgba(244, 228, 193, 0.45), transparent 70%);" data-parallax="0.05"></div>
    <div class="orb floaty" style="width: 600px; height: 600px; bottom: -150px; left: -150px; background: radial-gradient(circle, rgba(201, 169, 97, 0.55), transparent 70%);" data-parallax="-0.04"></div>

    <!-- Texture -->
    <div class="absolute inset-0 opacity-[0.05]"
      style="background-image: radial-gradient(circle at 1px 1px, #F4E4C1 1px, transparent 0); background-size: 28px 28px;"></div>

    <!-- Floating decorations -->
    <div class="absolute top-16 left-12 floaty opacity-50">
      <Decor variant="almond" class="h-24 w-14" />
    </div>
    <div class="absolute bottom-16 right-12 floaty-rev opacity-50">
      <Decor variant="almond" class="h-24 w-14" />
    </div>
    <div class="absolute top-1/3 right-20 spin-slow opacity-25">
      <Decor variant="gold-flourish" class="w-24 h-24" />
    </div>
  </div>

  <div class="mx-auto max-w-[900px] px-6 lg:px-10 text-center relative">
    <!-- Decorative top almond -->
    <div class="flex justify-center mb-8 reveal">
      <div class="relative floaty">
        <div class="absolute -inset-6 rounded-full bg-[#C9A961]/35 blur-2xl pulse-glow"></div>
        <Decor variant="almond" class="relative h-20 w-12" />
      </div>
    </div>

    <p class="eyebrow !text-[#E6CE94] reveal reveal-delay-1">
      <span class="inline-block w-8 h-px bg-[#E6CE94] align-middle mr-3"></span>
      Última chamada
      <span class="inline-block w-8 h-px bg-[#E6CE94] align-middle ml-3"></span>
    </p>

    <h2 class="headline-lg mt-4 reveal reveal-delay-2 text-[#FAF6EE]">
      A diferença é que
      <span class="block italic font-light shimmer-text">algumas começaram.</span>
    </h2>

    <div class="mt-10 sm:mt-12 reveal reveal-delay-3">
      <p class="font-display text-[#F4E4C1] italic leading-snug text-[clamp(1.25rem,4.5vw,1.75rem)]">
        Hoje você pode ser uma delas.
      </p>
    </div>

    <div class="mt-12 reveal reveal-delay-4">
      <a href="#oferta" class="btn-premium">
        <span>Quero começar no mercado de unhas</span>
        <svg viewBox="0 0 24 24" class="h-3 w-3 fill-none stroke-current" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>

      <!-- Pricing reminder -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[#F4E4C1]/80">
        <span class="text-[13px] uppercase tracking-[0.24em]">10x R$ 23,68</span>
        <span class="h-3 w-px bg-[#E6CE94]/40"></span>
        <span class="text-[13px] uppercase tracking-[0.24em]">ou R$ 197 à vista</span>
        <span class="h-3 w-px bg-[#E6CE94]/40"></span>
        <span class="text-[13px] uppercase tracking-[0.24em]">7 dias de garantia</span>
      </div>
    </div>
  </div>

  <!-- Footer brand strip -->
  <footer class="relative mt-28 lg:mt-36 mx-auto max-w-[1180px] px-6 lg:px-10">
    <Decor variant="wave-divider" class="w-full h-12 opacity-30" />

    <div class="mt-10 flex flex-col lg:flex-row items-center justify-between gap-6 text-center lg:text-left">
      <div class="flex items-center gap-3">
        <Decor variant="almond" class="h-7 w-4" />
        <span class="font-display text-xl text-[#FAF6EE]">Nail Designer <span class="shimmer-text font-medium">7D</span></span>
      </div>

      <p class="text-[12px] uppercase tracking-[0.24em] text-[#F4E4C1]/70">
        Thuany Carvalho · Nail Designer · Mentora
      </p>

      <p class="text-[11px] text-[#F4E4C1]/50">
        © 2025 · Todos os direitos reservados
      </p>
    </div>
  </footer>
</section>
