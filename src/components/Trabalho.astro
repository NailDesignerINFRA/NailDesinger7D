---
import Decor from "./Decor.astro";

const works = [
  { src: "01.jpg", label: "Molde F1 · Acabamento natural" },
  { src: "02.jpg", label: "Aplicação fina e nivelada" },
  { src: "03.jpg", label: "Acabamento profissional" },
  { src: "04.jpg", label: "Estrutura leve e elegante" },
  { src: "05.png", label: "Detalhe da pega" },
];
---

<section id="trabalho" class="relative isolate overflow-hidden py-20 lg:py-24 bg-[#FAF6EE]">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="orb orb-champagne" style="width: 480px; height: 480px; top: -120px; right: -120px; opacity: 0.55;" data-parallax="0.04"></div>
    <div class="orb orb-gold" style="width: 360px; height: 360px; bottom: -100px; left: -80px; opacity: 0.4;" data-parallax="-0.04"></div>
  </div>

  <div class="mx-auto max-w-[1280px] px-5 sm:px-6 lg:px-10">
    <!-- Header -->
    <div class="text-center mb-10 sm:mb-12">
      <p class="micro-label reveal text-[#A88842]">Trabalhos da Thuany</p>
      <h2 class="headline-lg mt-4 reveal reveal-delay-1 text-[#2A2118]">
        <span class="block">O resultado de quem aprendeu</span>
        <span class="block italic font-light text-[#8B6F47]">o caminho certo</span>
      </h2>
      <div class="mt-5 flex justify-center reveal reveal-delay-2">
        <Decor variant="brush" class="w-48 h-6 opacity-70" />
      </div>
    </div>

    <!-- Galeria asimétrica · mosaic style -->
    <div class="trabalho-grid reveal reveal-delay-2">
      {works.map((w, i) => (
        <figure class={`trabalho-item trabalho-item--${i + 1} group relative overflow-hidden rounded-[16px] sm:rounded-[20px] border border-[#C9A961]/22 shadow-[0_18px_50px_-26px_rgba(92,74,48,0.35)]`}>
          <img
            src={`/trabalho/${w.src}`}
            alt={w.label}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            width="720"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <!-- Overlay sutil só no hover -->
          <figcaption class="absolute inset-x-0 bottom-0 z-10 p-3 sm:p-4 bg-gradient-to-t from-[#1A140C]/85 via-[#1A140C]/30 to-transparent text-[#FAF6EE] opacity-0 translate-y-2 transition-all duration-500 group-hover:opacity-100 group-hover:translate-y-0">
            <p class="text-[11px] uppercase tracking-[0.2em] text-[#E6CE94]/90">{String(i + 1).padStart(2, "0")}</p>
            <p class="text-[13px] sm:text-[13.5px] mt-1 leading-snug">{w.label}</p>
          </figcaption>
          <!-- Pearl decor -->
          <span class="absolute top-2.5 right-2.5 z-10 w-2.5 h-2.5 rounded-full bg-[#E6CE94]/85 shadow-[0_0_12px_rgba(230,206,148,0.6)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  /* Mosaic responsivo */
  .trabalho-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 180px;
  }
  .trabalho-item {
    aspect-ratio: auto;
  }
  /* Mobile: 2 col, 1ª foto destaque ocupando linha cheia */
  .trabalho-item--1 {
    grid-column: span 2;
    grid-row: span 1;
  }

  @media (min-width: 640px) {
    .trabalho-grid {
      grid-template-columns: 1fr 1fr 1fr;
      grid-auto-rows: 200px;
      gap: 14px;
    }
    .trabalho-item--1 {
      grid-column: span 2;
      grid-row: span 2;
    }
    .trabalho-item--4 {
      grid-column: span 1;
    }
    .trabalho-item--5 {
      grid-column: span 1;
    }
  }

  @media (min-width: 1024px) {
    .trabalho-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 240px;
      gap: 16px;
    }
    /* Layout editorial: 1ª maior (2x2), demais distribuídas */
    .trabalho-item--1 { grid-column: span 2; grid-row: span 2; }
    .trabalho-item--2 { grid-column: span 2; grid-row: span 1; }
    .trabalho-item--3 { grid-column: span 1; grid-row: span 1; }
    .trabalho-item--4 { grid-column: span 1; grid-row: span 1; }
    .trabalho-item--5 { grid-column: span 2; grid-row: span 1; }
  }
</style>
