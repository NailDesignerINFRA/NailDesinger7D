---
import Decor from "./Decor.astro";

const traps = [
  {
    n: "01",
    t: "Materiais errados",
    d: "Investimento perdido em produtos que não eram necessários.",
    icon: "polish-bottle",
  },
  {
    n: "02",
    t: "Técnicas avançadas demais",
    d: "Frustração antes mesmo de dominar o básico.",
    icon: "dotting-tool",
  },
  {
    n: "03",
    t: "Conteúdo solto na internet",
    d: "Aprendizado fragmentado, sem caminho claro.",
    icon: "nail-file",
  },
  {
    n: "04",
    t: "Insegurança e medo",
    d: "A crença de que “não leva jeito”.",
    icon: "molde-f1",
  },
] as const;
---

<section id="problema" class="problem-refactor-section relative isolate overflow-hidden bg-[#FAF6EE] py-24 lg:py-34">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="absolute inset-0 opacity-[0.05]"
      style="background-image: linear-gradient(to right, #8B6F47 1px, transparent 1px), linear-gradient(to bottom, #8B6F47 1px, transparent 1px); background-size: 96px 96px;"></div>
    <div class="orb orb-nude" style="width: 520px; height: 520px; top: 8%; right: -140px;" data-parallax="0.04"></div>
    <div class="orb orb-champagne" style="width: 380px; height: 380px; bottom: -80px; left: -120px; opacity: 0.72;" data-parallax="-0.03"></div>
  </div>

  <div class="mx-auto max-w-[1180px] px-6 lg:px-10">
    <div class="problem-refactor-header relative mb-14 text-center lg:mb-18">
      <div class="absolute left-[3%] top-3 hidden rotate-[-18deg] opacity-75 md:block">
        <Decor variant="cuticle-pusher" class="h-24 w-24 floaty-rev" />
      </div>
      <div class="absolute right-[4%] top-14 hidden rotate-[12deg] opacity-80 md:block">
        <Decor variant="polish-bottle" class="h-24 w-20 floaty" />
      </div>

      <p class="micro-label reveal text-[#A88842]">Por que tantas iniciantes travam</p>

      <h2 class="headline-lg problem-main-title mx-auto mt-7 max-w-[1040px] reveal reveal-delay-1 text-[#2A2118]">
        <span class="block md:whitespace-nowrap">Existe um motivo pelo qual tantas iniciantes</span>
        <span class="block md:whitespace-nowrap"><span class="italic font-light text-[#8B6F47]">desistem</span> de aprender unhas</span>
      </h2>

      <div class="mt-8 flex justify-center reveal reveal-delay-2">
        <Decor variant="brush" class="w-48 h-6" />
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-[0.98fr_1.02fr] lg:gap-10 xl:gap-14">
      <div class="problem-story reveal relative overflow-hidden rounded-[24px] border border-[#C9A961]/24 bg-[#1A140C] p-5 shadow-[0_28px_90px_-42px_rgba(42,33,24,0.9)] sm:p-7 lg:p-8" data-problem-interactive>
        <div class="absolute -right-8 -top-10 z-0 opacity-20">
          <Decor variant="nail-file" class="h-24 w-64 rotate-[18deg]" />
        </div>
        <div class="absolute bottom-10 right-8 z-0 opacity-20">
          <Decor variant="particle-cluster" class="h-40 w-40" />
        </div>

        <div class="relative z-10">
          <div class="flex items-center justify-between gap-4">
            <p class="eyebrow !text-[#E6CE94]">A maioria começa da forma errada</p>
            <Decor variant="almond" class="h-12 w-7 shrink-0 opacity-90" />
          </div>

          <div class="mt-7 grid gap-3">
            {[
              "Compra materiais sem saber o que realmente precisa.",
              "Tenta aprender técnicas difíceis demais.",
              "Fica insegura, erra aplicações e perde produto.",
              "Começa a acreditar que não nasceu para isso.",
            ].map((text, index) => (
              <div class="mistake-row group flex items-center gap-3 rounded-[16px] border border-[#E6CE94]/14 bg-[#FFFEFB]/7 px-4 py-3.5 backdrop-blur-sm transition duration-500 hover:-translate-y-0.5 hover:border-[#E6CE94]/35 hover:bg-[#FFFEFB]/11">
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[#E6CE94]/12 font-display text-[16px] leading-none text-[#E6CE94] tabular-nums">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="text-[14px] font-medium leading-snug text-[#FAF6EE] sm:text-[15px]">{text}</p>
              </div>
            ))}
          </div>

          <div class="mt-7 rounded-[18px] border border-[#E6CE94]/20 bg-[#E6CE94]/10 p-4 sm:p-5">
            <p class="font-display text-[clamp(1.28rem,4vw,1.65rem)] leading-tight text-[#FFFEFB]">
              Mas o problema não é falta de talento.
            </p>
            <p class="mt-3 text-[14px] leading-relaxed text-[#F4E4C1]/86 sm:text-[15px]">
              O problema é tentar começar por métodos complexos que não foram feitos para iniciantes.
            </p>
          </div>

          <p class="mt-6 font-display italic text-[clamp(1.35rem,4.4vw,1.85rem)] leading-tight text-[#E6CE94]">
            Foi exatamente por isso que o Nail Designer 7D foi criado.
          </p>
        </div>
      </div>

      <div class="relative reveal reveal-delay-2">
        <div class="tool-orbit pointer-events-none absolute -inset-5 -z-0 hidden md:block">
          <Decor variant="dotting-tool" class="absolute -right-7 top-8 h-28 w-28 rotate-[24deg] opacity-55 floaty" />
          <Decor variant="nail-file" class="absolute -left-8 top-1/2 h-16 w-44 -rotate-[14deg] opacity-60 floaty-rev" />
          <Decor variant="molde-f1" class="absolute bottom-5 right-10 h-24 w-14 opacity-55 floaty" />
        </div>

        <div class="trap-board relative overflow-hidden rounded-[24px] border border-[#C9A961]/26 bg-[#FAF6EE]/88 p-5 shadow-[0_28px_90px_-46px_rgba(92,74,48,0.45)] backdrop-blur-xl sm:p-7 lg:p-8" data-problem-interactive>
          <div class="absolute -right-12 -top-12 h-36 w-36 opacity-25 spin-slow">
            <Decor variant="gold-flourish" class="h-full w-full" />
          </div>

          <p class="eyebrow text-[#A88842]">As armadilhas comuns</p>
          <h3 class="mt-3 font-display text-[clamp(1.8rem,5vw,2.6rem)] leading-tight text-[#2A2118]">
            O que <span class="italic text-[#8B6F47]">trava</span> a iniciante
          </h3>

          <ul class="mt-6 grid gap-3.5 sm:mt-7">
            {traps.map((item) => (
              <li class="trap-card group relative overflow-hidden rounded-[18px] border border-[#C9A961]/18 bg-[#FFFEFB] p-4 shadow-[0_16px_50px_-40px_rgba(42,33,24,0.75)] transition duration-500 hover:-translate-y-1 hover:border-[#C9A961]/45 hover:shadow-[0_24px_70px_-44px_rgba(168,136,66,0.85)]" data-problem-interactive>
                <div class="flex items-start gap-4">
                  <div class="trap-icon grid h-13 w-13 shrink-0 place-items-center rounded-[14px] bg-[#1A140C]">
                    <Decor variant={item.icon} class="h-9 w-9" />
                  </div>
                  <div class="min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="font-display text-[18px] leading-none text-[#C9A961] tabular-nums">{item.n}</span>
                      <p class="font-display text-[18px] leading-tight text-[#2A2118] sm:text-[20px]">{item.t}</p>
                    </div>
                    <p class="mt-1.5 text-[13.5px] leading-relaxed text-[#5C4A30] sm:text-[14px]">{item.d}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>

          <div class="mt-6 flex items-center justify-between gap-4 border-t border-[#C9A961]/20 pt-5">
            <span class="font-script text-[clamp(1.45rem,4.8vw,1.95rem)] leading-none text-[#8B6F47]">Há um caminho mais leve</span>
            <div class="flex shrink-0 items-center gap-2">
              <Decor variant="pearl" class="h-5 w-5" />
              <Decor variant="almond-outline" class="h-8 w-5" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const interactiveProblemCards = document.querySelectorAll<HTMLElement>('[data-problem-interactive]');

  interactiveProblemCards.forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const rect = card.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;

      card.style.setProperty('--mx', `${x}%`);
      card.style.setProperty('--my', `${y}%`);
    });
  });
</script>

<style>
  .problem-story,
  .trap-board,
  .trap-card {
    isolation: isolate;
  }

  .problem-story::before,
  .trap-board::before,
  .trap-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle at var(--mx, 50%) var(--my, 20%), rgba(230, 206, 148, 0.24), transparent 36%);
    opacity: 0;
    transition: opacity 450ms var(--ease-premium);
    pointer-events: none;
  }

  .problem-story:hover::before,
  .trap-board:hover::before,
  .trap-card:hover::before {
    opacity: 1;
  }

  .trap-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(120deg, transparent 20%, rgba(255, 254, 251, 0.7) 44%, transparent 66%);
    opacity: 0;
    transform: translateX(-45%);
    transition:
      opacity 500ms var(--ease-premium),
      transform 800ms var(--ease-cinematic);
  }

  .trap-card:hover::after {
    opacity: 1;
    transform: translateX(45%);
  }

  .mistake-row {
    position: relative;
  }

  .mistake-row::after {
    content: "";
    position: absolute;
    right: 14px;
    top: 50%;
    width: 34px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(230, 206, 148, 0.5));
    transform: translateY(-50%);
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .problem-refactor-header {
      margin-bottom: 2.35rem;
    }

    .problem-main-title {
      max-width: 10.6em;
      font-size: clamp(2.05rem, 10.4vw, 2.55rem);
      line-height: 1.02;
    }

    .problem-story,
    .trap-board {
      border-radius: 20px;
      padding: 18px;
    }

    .problem-story .eyebrow,
    .trap-board .eyebrow {
      line-height: 1.45;
    }

    .mistake-row {
      align-items: flex-start;
      gap: 12px;
      border-radius: 14px;
      padding: 12px;
    }

    .mistake-row::after {
      display: none;
    }

    .trap-card {
      border-radius: 16px;
      padding: 14px;
    }

    .trap-card > div {
      gap: 12px;
    }

    .trap-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
    }

    .trap-icon svg {
      width: 32px;
      height: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trap-card,
    .mistake-row {
      transition: none;
    }

    .trap-card::after {
      display: none;
    }
  }
</style>
