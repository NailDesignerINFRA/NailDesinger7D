---
const includes = [
  "Curso completo Nail Designer 7D",
  "Aulas do Molde F1 passo a passo",
  "Lista oficial de materiais essenciais",
  "Manutenção e durabilidade profissional",
  "Acesso por 1 ano · estude no seu ritmo",
];

const bonuses = [
  { t: "Guia de primeiros atendimentos", v: "R$ 97" },
  { t: "Tabela de precificação para iniciantes", v: "R$ 67" },
];
---

<section id="oferta" class="oferta-section relative isolate overflow-hidden py-14 sm:py-16 lg:py-20">
  <!-- Background editorial dark -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-br from-[#241B12] via-[#2F2519] to-[#1F1810]"></div>
    <div class="absolute inset-0 opacity-[0.05]"
      style="background-image: radial-gradient(circle at 1px 1px, #F4E4C1 1px, transparent 0); background-size: 28px 28px;"></div>
    <div class="orb floaty-slow"
      style="width: 460px; height: 460px; top: -160px; right: -140px; background: radial-gradient(circle, rgba(201,169,97,0.36), transparent 70%);"
      data-parallax="0.04"></div>
  </div>

  <div class="mx-auto max-w-[980px] px-5 sm:px-6">
    <!-- Header enxuto -->
    <div class="text-center mb-7 sm:mb-9">
      <span class="tag-sale reveal">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#F4E4C1] animate-pulse"></span>
        Oferta de lançamento
      </span>
      <h2 class="headline-lg text-[#FAF6EE] mt-4 reveal reveal-delay-1">
        <span class="block">Acesso completo ao</span>
        <span class="block italic font-light text-[#E6CE94]">Nail Designer 7D</span>
      </h2>
    </div>

    <!-- ─── OFFER CARD (retangular) ─── -->
    <div class="relative reveal reveal-delay-2">
      <!-- Halo -->
      <div class="absolute -inset-3 sm:-inset-5 -z-10 rounded-[28px] bg-gradient-to-br from-[#E6CE94]/22 via-[#C9A961]/15 to-transparent blur-2xl pulse-glow pointer-events-none"></div>
      <!-- Moldura dourada -->
      <div class="absolute -inset-[1.5px] rounded-[22px] bg-gradient-to-br from-[#E6CE94] via-[#C9A961] to-[#8B6F47] opacity-80"></div>

      <article class="offer-card relative rounded-[20px] overflow-hidden"
        style="background: linear-gradient(180deg, #FFFEFB 0%, #F9F2E2 100%);">

        <!-- Grid 2 colunas no desktop, stack no mobile -->
        <div class="offer-card__grid">
          <!-- Coluna 1: PREÇO + CTA -->
          <div class="offer-card__price">
            <p class="text-[10.5px] sm:text-[11px] uppercase tracking-[0.26em] text-[#8B6F47]">
              De <span class="strike-price text-[16px] sm:text-[18px] font-display">R$ 397</span> · por apenas
            </p>

            <div class="mt-2 flex items-end justify-center lg:justify-start gap-1.5 leading-none">
              <span class="font-display text-[#8B6F47] text-[20px] sm:text-[24px] mt-2">R$</span>
              <span class="font-display font-medium tabular-nums text-transparent bg-clip-text bg-gradient-to-b from-[#A88842] via-[#8B6F47] to-[#5C4A30] text-[clamp(3.25rem,10vw,5rem)]">197</span>
              <span class="font-display text-[#8B6F47] text-[16px] sm:text-[20px] self-end pb-3 italic">à vista</span>
            </div>

            <p class="mt-1.5 text-[12.5px] sm:text-[13.5px] text-[#5C4A30]">
              ou <span class="font-medium text-[#2A2118]">10x de R$ 23,68</span> no cartão
            </p>

            <p class="mt-3 inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#E8F3EC] text-[#2A5A41] text-[10.5px] font-semibold tracking-[0.12em] uppercase">
              <svg viewBox="0 0 24 24" class="h-3 w-3 fill-current" aria-hidden="true"><path d="M12 2l9 4-1 12-8 4-8-4L3 6z"/></svg>
              Você economiza R$ 200
            </p>

            <a
              href="https://pay.hotmart.com/N95036193B?checkoutMode=10"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-premium w-full mt-5"
            >
              <span>Garantir meu acesso</span>
              <svg viewBox="0 0 24 24" class="h-3 w-3 fill-none stroke-current" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>

            <p class="mt-2.5 text-center lg:text-left text-[10.5px] uppercase tracking-[0.2em] text-[#8B6F47]/85">
              Acesso liberado em até 2 minutos
            </p>

            <!-- Trust badges -->
            <div class="mt-5 flex flex-wrap items-center justify-center lg:justify-start gap-x-4 gap-y-2 border-t border-[#C9A961]/15 pt-4">
              <span class="trust-mini">
                <svg viewBox="0 0 24 24" class="fill-none stroke-current" stroke-width="1.6" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6z"/></svg>
                7d garantia
              </span>
              <span class="trust-mini">
                <svg viewBox="0 0 24 24" class="fill-none stroke-current" stroke-width="1.6" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/></svg>
                Pagto seguro
              </span>
              <span class="trust-mini">
                <svg viewBox="0 0 24 24" class="fill-none stroke-current" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                Acesso 1 ano
              </span>
            </div>
          </div>

          <!-- Divisor vertical (só desktop) -->
          <div class="offer-card__divider" aria-hidden="true"></div>

          <!-- Coluna 2: INCLUSO + BÔNUS -->
          <div class="offer-card__contents">
            <p class="text-[10.5px] uppercase tracking-[0.26em] text-[#8B6F47] font-semibold">O que está incluso</p>
            <ul class="mt-3.5 grid gap-2">
              {includes.map((item) => (
                <li class="flex items-start gap-2.5 text-[13.5px] sm:text-[14px] text-[#2A2118] leading-snug">
                  <span class="check-bullet">
                    <svg viewBox="0 0 24 24" class="h-2.5 w-2.5 fill-none stroke-current" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-5 rounded-[12px] border border-dashed border-[#C9A961]/45 bg-[#FFFEFB]/70 p-3.5">
              <p class="text-[10px] uppercase tracking-[0.24em] text-[#A88842] font-semibold">+ Bônus exclusivos</p>
              <ul class="mt-2.5 grid gap-2">
                {bonuses.map((b) => (
                  <li class="flex items-start justify-between gap-3 text-[13px] sm:text-[13.5px] text-[#2A2118]">
                    <span class="flex items-start gap-2 min-w-0">
                      <span class="text-[#A88842] mt-0.5">✦</span>
                      <span>{b.t}</span>
                    </span>
                    <span class="strike-price text-[12.5px] sm:text-[13px] shrink-0 mt-0.5">{b.v}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </article>
    </div>

    <!-- Garantia (faixa horizontal compacta) -->
    <div class="mt-6 sm:mt-7 max-w-[640px] mx-auto flex items-center gap-3.5 rounded-[14px] border border-[#C9A961]/22 bg-[#FAF6EE]/8 px-4 py-3 reveal reveal-delay-3">
      <div class="shrink-0 grid place-items-center w-10 h-10 rounded-full border border-[#E6CE94]/45">
        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-[#E6CE94]" stroke-width="1.4" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
      </div>
      <div class="text-[12.5px] sm:text-[13px] leading-snug text-[#F4E4C1]/85">
        <p class="font-medium text-[#FAF6EE]">Garantia incondicional de 7 dias</p>
        <p class="mt-0.5">Se não for pra você, devolvemos 100% do valor — sem perguntas.</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* ──────────────────────────────────────────────
     CARD RETANGULAR
  ────────────────────────────────────────────── */
  .offer-card__grid {
    display: grid;
    grid-template-columns: 1fr;
    padding: 1.5rem 1.25rem 1.5rem;
  }
  .offer-card__divider {
    display: none;
  }
  .offer-card__price {
    text-align: center;
  }
  .offer-card__contents {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(201, 169, 97, 0.2);
  }

  @media (min-width: 640px) {
    .offer-card__grid {
      padding: 1.75rem 1.75rem 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .offer-card__grid {
      grid-template-columns: 1fr 1px 1fr;
      gap: 2.25rem;
      padding: 2rem 2.25rem;
      align-items: center;
    }
    .offer-card__price {
      text-align: left;
    }
    .offer-card__contents {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }
    .offer-card__divider {
      display: block;
      width: 1px;
      align-self: stretch;
      background: linear-gradient(180deg, transparent 0%, rgba(201, 169, 97, 0.45) 50%, transparent 100%);
    }
  }

  /* Override do global do padding -- já é só para evitar verticalidade exagerada */
  @media (max-width: 639px) {
    .oferta-section {
      padding-top: 48px !important;
      padding-bottom: 56px !important;
    }
  }
</style>
