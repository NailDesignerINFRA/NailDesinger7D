---
interface Props {
  videoId?: string;
  title?: string;
}

const {
  videoId = "SFsN3Fy3CJY",
  title = "Vídeo de apresentação · Nail Designer 7D",
} = Astro.props;

// autoplay precisa de mute=1 nos browsers; loop exige playlist=VIDEO_ID
const embedUrl =
  `https://www.youtube-nocookie.com/embed/${videoId}` +
  `?autoplay=1&mute=1&loop=1&playlist=${videoId}` +
  `&playsinline=1&controls=0&rel=0&modestbranding=1&iv_load_policy=3` +
  `&enablejsapi=1`;
---

<div class="vsl-player relative overflow-hidden rounded-[14px]" style="aspect-ratio: 16/9;" data-vsl>
  <iframe
    class="absolute inset-0 h-full w-full"
    src={embedUrl}
    title={title}
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    loading="eager"
    data-vsl-iframe
  ></iframe>

  <!-- Overlay clicável: ativa som + reinicia -->
  <button
    type="button"
    class="vsl-overlay group absolute inset-0 z-30 flex flex-col items-center justify-center gap-3 text-[#FFFEFB]"
    data-vsl-overlay
    aria-label="Clique para ativar o som e reiniciar o vídeo"
  >
    <span class="vsl-overlay__bg absolute inset-0 bg-gradient-to-b from-[#1A140C]/35 via-[#1A140C]/10 to-[#1A140C]/65 transition-opacity duration-500 group-hover:opacity-90"></span>

    <span class="relative grid place-items-center w-[68px] h-[68px] sm:w-[80px] sm:h-[80px] rounded-full border border-[#E6CE94]/55 bg-[#1A140C]/60 backdrop-blur-sm shadow-[0_18px_50px_-18px_rgba(0,0,0,0.7)] transition-transform duration-500 group-hover:scale-105">
      <span class="absolute inset-0 rounded-full bg-[#C9A961]/25 blur-xl pulse-glow"></span>
      <svg viewBox="0 0 24 24" class="relative h-6 w-6 sm:h-7 sm:w-7 fill-[#F4E4C1]" aria-hidden="true">
        <!-- Speaker -->
        <path d="M11 5L6 9H3v6h3l5 4V5z"/>
        <!-- Mute X -->
        <path d="M16.5 9l4.5 6M21 9l-4.5 6" stroke="#F4E4C1" stroke-width="1.6" fill="none" stroke-linecap="round"/>
      </svg>
    </span>

    <span class="relative inline-flex items-center gap-2 rounded-full bg-[#1A140C]/70 px-3.5 py-1.5 text-[10.5px] sm:text-[11.5px] uppercase tracking-[0.22em] font-medium backdrop-blur-sm">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#E6CE94] animate-pulse"></span>
      Clique para ativar o som
    </span>
  </button>
</div>

<script>
  const overlays = document.querySelectorAll<HTMLElement>('[data-vsl-overlay]');
  overlays.forEach((overlay) => {
    overlay.addEventListener('click', () => {
      const player = overlay.parentElement;
      const iframe = player?.querySelector<HTMLIFrameElement>('[data-vsl-iframe]');
      if (!iframe?.contentWindow) return;
      const win = iframe.contentWindow;
      const send = (func: string, args: unknown = '') => {
        win.postMessage(JSON.stringify({ event: 'command', func, args }), '*');
      };
      send('unMute');
      send('setVolume', [100]);
      send('seekTo', [0, true]);
      send('playVideo');
      overlay.classList.add('is-hidden');
    });
  });
</script>

<style>
  .vsl-player {
    background: #090705;
    box-shadow:
      inset 0 0 0 1px rgba(244, 228, 193, 0.18),
      0 16px 50px -24px rgba(0, 0, 0, 0.7);
  }

  .vsl-overlay {
    cursor: pointer;
    border: 0;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    padding: 0;
    transition:
      opacity 400ms var(--ease-premium),
      visibility 400ms var(--ease-premium);
  }
  .vsl-overlay.is-hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }
  .vsl-overlay:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: -4px;
    border-radius: inherit;
  }
</style>
