---
const cards = [
  { n: "01", t: "Nunca fez unha profissionalmente" },
  { n: "02", t: "Não sabe quais materiais comprar" },
  { n: "03", t: "Tem medo de errar" },
  { n: "04", t: 'Acha que "não leva jeito"' },
  { n: "05", t: "Não conseguiu aprender sozinha" },
];
---

<section id="inicio-do-zero" class="relative isolate my-12 overflow-visible bg-[#FAF6EE] px-5 py-10 sm:my-16 sm:px-6 sm:py-14 lg:px-10" data-problem-section>
  <div class="mx-auto w-full max-w-[1180px]">
    <div class="relative grid gap-8 lg:grid-cols-[minmax(0,560px)_minmax(360px,1fr)] lg:items-end">
      <div class="problem-copy relative z-20 w-full max-w-[390px] sm:max-w-[520px]" data-problem-cards>
        <div class="mb-5 max-w-xl text-left sm:mb-6">
          <p class="eyebrow text-[#A88842]">Comece do zero</p>
          <h2 class="mt-3 font-display text-[28px] leading-[1.02] text-[#2A2118] sm:text-[36px] md:text-[42px]">
            Mesmo que hoje você:
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-2.5 sm:gap-2.5">
          {cards.map((card, index) => (
            <div
              class="scroll-card min-w-0"
              data-scroll-card
              style={`--card-delay: ${index * 70}ms; opacity: 0; transform: translateY(36px) scale(.97);`}
            >
              <article class="problem-card group relative flex min-h-[56px] min-w-0 items-center gap-3 overflow-hidden rounded-[14px] border border-[#C9A961]/20 bg-[#1A140C] px-3.5 py-2.5 text-left shadow-[0_14px_44px_-32px_rgba(42,33,24,0.85)] transition duration-500 hover:-translate-y-0.5 hover:border-[#E6CE94]/45 hover:shadow-[0_20px_56px_-34px_rgba(168,136,66,0.85)] sm:min-h-[62px] sm:gap-4 sm:px-4 sm:py-3">
                <span class="relative z-10 shrink-0 font-display text-[24px] leading-none text-[#E6CE94]/80 transition duration-500 group-hover:text-[#F4E4C1] sm:text-[28px]">
                  {card.n}
                </span>
                <p class="relative z-10 min-w-0 break-words text-[13.5px] font-medium leading-snug text-[#FAF6EE] sm:text-[14.5px]">
                  {card.t}
                </p>
              </article>
            </div>
          ))}
        </div>

        <div class="animate-fade-card conclusion-card mt-3 overflow-hidden rounded-[14px] border border-[#C9A961]/22 bg-[#1A140C] px-3.5 py-3 text-left shadow-[0_14px_44px_-32px_rgba(42,33,24,0.85)] sm:px-4 sm:py-3.5">
          <p class="relative z-10 border-l border-[#E6CE94]/55 pl-3.5 text-[13.5px] font-medium leading-[1.55] text-[#FAF6EE] sm:text-[14.5px]">
            <span class="text-[#E6CE94]">Em poucos dias,</span> você pode aprender a técnica, praticar e dar os primeiros passos para começar seus atendimentos.
          </p>
        </div>
      </div>

      <div class="expert-photo-wrap relative z-10 mx-auto min-h-[390px] w-full max-w-[330px] sm:min-h-[520px] sm:max-w-[440px] lg:-ml-6 lg:-mt-36 lg:min-h-[660px] lg:max-w-none" data-expert-photo>
        <img
          src="/expert1.png"
          alt="Thuany Carvalho, expert do Nail Designer 7D"
          class="expert-photo absolute bottom-16 left-1/2 z-10 h-[108%] w-auto max-w-none object-contain drop-shadow-[0_28px_55px_rgba(26,20,12,0.32)] lg:bottom-24 lg:h-[118%]"
          width="600"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<script>
  const sectionRoot = document.querySelector<HTMLElement>('[data-problem-section]');
  const problemSection = document.querySelector<HTMLElement>('[data-problem-cards]');
  const scrollCards = problemSection?.querySelectorAll<HTMLElement>('[data-scroll-card]');
  const expertPhoto = document.querySelector<HTMLElement>('[data-expert-photo]');

  const updateScrollCards = () => {
    if (!problemSection || !scrollCards?.length) return;

    const rect = problemSection.getBoundingClientRect();
    const viewportHeight = window.innerHeight;
    // Quando o topo da seção atinge ~85% da viewport (entrando)  → progress=0
    // Quando o topo passa ~25% da viewport (claramente em foco)   → progress=1
    const start = viewportHeight * 0.88;
    const end = viewportHeight * 0.25;
    const raw = (start - rect.top) / (start - end);
    const progress = Math.min(Math.max(raw, 0), 1);

    Array.from(scrollCards).forEach((card, index) => {
      const cardEl = card as HTMLElement;
      // Stagger curto (0.07) e janela curta (0.55) por card — fica nítido bem cedo
      const cardProgress = Math.min(Math.max((progress - index * 0.07) / 0.55, 0), 1);
      const translateY = 36 * (1 - cardProgress);
      const scale = 0.97 + cardProgress * 0.03;
      cardEl.style.transform = `translateY(${translateY}px) scale(${scale})`;
      cardEl.style.opacity = `${cardProgress}`;
    });
  };

  updateScrollCards();
  window.addEventListener('scroll', updateScrollCards, { passive: true });
  window.addEventListener('resize', updateScrollCards);

  if (sectionRoot && expertPhoto) {
    const photoObserver = new IntersectionObserver(
      ([entry]) => {
        sectionRoot.classList.toggle('is-problem-in', entry.isIntersecting);
      },
      {
        root: null,
        threshold: 0.28,
      },
    );

    photoObserver.observe(sectionRoot);
  }
</script>

<style>
  .scroll-card {
    will-change: opacity, transform;
    transition:
      opacity 600ms var(--ease-premium),
      transform 600ms var(--ease-premium);
    transition-delay: var(--card-delay, 0ms);
  }

  .problem-card {
    isolation: isolate;
    background:
      radial-gradient(circle at 22% 18%, rgba(230, 206, 148, 0.22), transparent 34%),
      linear-gradient(145deg, rgba(42, 33, 24, 0.96), rgba(26, 20, 12, 0.98));
  }

  .problem-card::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: 0;
    background:
      linear-gradient(120deg, transparent 20%, rgba(255, 254, 251, 0.18) 45%, transparent 70%),
      linear-gradient(180deg, rgba(230, 206, 148, 0.18), transparent 52%);
    opacity: 0;
    transform: translateX(-35%);
    transition:
      opacity 500ms var(--ease-premium),
      transform 700ms var(--ease-cinematic);
  }

  .problem-card::after {
    content: "";
    position: absolute;
    right: 14px;
    top: 14px;
    z-index: 0;
    width: 30%;
    aspect-ratio: 1;
    border: 1px solid rgba(230, 206, 148, 0.2);
    transform: rotate(8deg);
    transition:
      border-color 500ms var(--ease-premium),
      transform 500ms var(--ease-premium);
  }

  .problem-card:hover::before {
    opacity: 1;
    transform: translateX(0);
  }

  .problem-card:hover::after {
    border-color: rgba(230, 206, 148, 0.42);
    transform: rotate(0deg) scale(1.08);
  }

  .conclusion-card {
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(circle at 16% 18%, rgba(230, 206, 148, 0.18), transparent 36%),
      linear-gradient(145deg, rgba(42, 33, 24, 0.98), rgba(26, 20, 12, 0.98));
  }

  .conclusion-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(120deg, transparent 30%, rgba(255, 254, 251, 0.16) 50%, transparent 70%);
    background-size: 220% 100%;
    animation: conclusionShine 5.5s ease-in-out infinite;
  }

  .problem-copy {
    opacity: 0;
    transform: translate3d(-96px, 0, 0);
    transition:
      opacity 900ms var(--ease-premium),
      transform 1100ms var(--ease-cinematic);
    will-change: opacity, transform;
  }

  .is-problem-in .problem-copy {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .expert-photo-wrap {
    isolation: isolate;
    opacity: 0;
    transform: translate3d(96px, 90px, 0);
    transition:
      opacity 900ms var(--ease-premium),
      transform 1100ms var(--ease-cinematic);
    will-change: opacity, transform;
  }

  .is-problem-in .expert-photo-wrap {
    opacity: 1;
    transform: translate3d(0, 90px, 0);
  }

  .expert-photo-wrap::after {
    content: "";
    position: absolute;
    inset-inline: -14%;
    bottom: -18px;
    z-index: 20;
    height: 40%;
    background:
      radial-gradient(75% 60% at 50% 84%, rgba(250, 246, 238, 0.98) 0%, rgba(250, 246, 238, 0.8) 42%, rgba(250, 246, 238, 0) 78%),
      linear-gradient(180deg, rgba(250, 246, 238, 0) 0%, rgba(250, 246, 238, 0.92) 54%, #FAF6EE 100%);
    filter: blur(18px);
    pointer-events: none;
  }

  .expert-photo {
    animation: expertFloat 8s ease-in-out infinite;
    filter: drop-shadow(0 26px 54px rgba(26, 20, 12, 0.38));
    transform: translate3d(-50%, 0, 0);
  }

  .animate-fade-card {
    animation: fadeInUp .8s ease forwards;
    opacity: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes conclusionShine {
    0%, 35% {
      background-position: 220% 0;
    }
    70%, 100% {
      background-position: -120% 0;
    }
  }

  @keyframes expertFloat {
    0%, 100% {
      transform: translate3d(-50%, 0, 0);
    }
    50% {
      transform: translate3d(-50%, -18px, 0);
    }
  }

  @media (min-width: 1024px) {
    .problem-copy {
      transform: translate3d(-120px, 0, 0);
    }

    .is-problem-in .problem-copy {
      transform: translate3d(0, 0, 0);
    }

    .expert-photo-wrap {
      transform: translate3d(120px, 70px, 0);
    }

    .is-problem-in .expert-photo-wrap {
      transform: translate3d(0, 70px, 0);
    }
  }

  @media (max-width: 639px) {
    #inicio-do-zero {
      overflow: hidden;
    }

    .problem-copy {
      max-width: 100%;
      transform: translate3d(-32px, 0, 0);
    }

    .is-problem-in .problem-copy {
      transform: translate3d(0, 0, 0);
    }

    .problem-copy h2 {
      max-width: 9.5em;
      font-size: clamp(2.15rem, 11vw, 2.75rem);
      line-height: 0.98;
    }

    .problem-card {
      min-height: 66px;
      gap: 12px;
      border-radius: 14px;
      padding: 13px 14px;
    }

    .problem-card span {
      font-size: 28px;
    }

    .problem-card p {
      font-size: 13.5px;
      line-height: 1.25;
    }

    .conclusion-card {
      border-radius: 14px;
    }

    .expert-photo-wrap {
      margin-top: -12px;
      transform: translate3d(58px, 110px, 0);
    }

    .is-problem-in .expert-photo-wrap {
      transform: translate3d(0, 110px, 0);
    }

    .expert-photo {
      bottom: 2rem !important;
      height: 112% !important;
    }

    .expert-photo-wrap::after {
      inset-inline: -20%;
      bottom: -24px;
      height: 44%;
      filter: blur(22px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-card,
    .animate-fade-card,
    .problem-copy,
    .expert-photo-wrap {
      animation: none;
      opacity: 1 !important;
      transform: none !important;
    }

    .problem-card::before,
    .conclusion-card::before {
      animation: none;
      transition: none;
    }

    .expert-photo {
      animation: none;
      transform: translate3d(-50%, 0, 0);
    }
  }
</style>
