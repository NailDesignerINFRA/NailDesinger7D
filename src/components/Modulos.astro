---
import Decor from "./Decor.astro";

const modules = [
  {
    n: "01",
    label: "Fundamento",
    title: "Entendendo o mercado",
    desc: "Entenda como funciona o mercado, como será sua jornada e o que realmente importa para começar da forma certa.",
  },
  {
    n: "02",
    label: "Materiais",
    title: "Compra inteligente",
    desc: "Aprenda quais materiais realmente precisa comprar para começar com inteligência, mesmo com pouco investimento e sem desperdícios desnecessários.",
  },
  {
    n: "03",
    label: "Aplicação",
    title: "Molde F1 passo a passo",
    desc: "Aprenda o passo a passo da aplicação do Molde F1 com técnicas que facilitam o processo até para quem nunca conseguiu fazer unhas antes.",
  },
  {
    n: "04",
    label: "Profissional",
    title: "Manutenção e durabilidade",
    desc: "Descubra como fazer a manutenção corretamente para aumentar a durabilidade das unhas e entregar resultados cada vez mais profissionais.",
  },
];
---

<section id="modulos" class="relative isolate overflow-hidden py-28 lg:py-40 bg-[#FAF6EE]">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="orb orb-champagne" style="width: 540px; height: 540px; top: -100px; right: -100px;" data-parallax="0.04"></div>
    <div class="orb orb-gold" style="width: 360px; height: 360px; bottom: 10%; left: -80px; opacity: 0.5;" data-parallax="-0.05"></div>
    <div class="absolute top-32 right-20 w-20 h-20 opacity-25 floaty">
      <Decor variant="gold-flourish" class="w-full h-full" />
    </div>
  </div>

  <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <p class="micro-label reveal text-[#A88842]">A grade do curso</p>
      <h2 class="headline-lg mt-4 reveal reveal-delay-1 text-[#2A2118]">
        O que você vai
        <span class="italic font-light text-[#8B6F47]">aprender</span>
        no Nail Designer 7D
      </h2>
      <div class="mt-8 flex justify-center reveal reveal-delay-2">
        <Decor variant="nail-arc" class="w-72 h-10 opacity-70" />
      </div>
    </div>

    <!-- Modules — editorial timeline -->
    <div class="relative max-w-[1100px] mx-auto">
      <!-- Center golden line -->
      <div class="hidden lg:block absolute left-1/2 -translate-x-1/2 top-6 bottom-6 w-px bg-gradient-to-b from-transparent via-[#C9A961]/40 to-transparent"></div>

      <div class="space-y-12 lg:space-y-20">
        {modules.map((m, i) => (
          <article class={`reveal reveal-delay-${(i % 4) + 1} relative grid lg:grid-cols-2 gap-6 lg:gap-16 items-center ${i % 2 ? 'lg:[direction:rtl]' : ''}`}>
            <!-- Module visual side -->
            <div class={`relative ${i % 2 ? 'lg:[direction:ltr]' : ''}`}>
              <div class="absolute -inset-4 bg-gradient-to-br from-[#F4E4C1]/40 to-[#E6CE94]/20 blur-2xl rounded-[28px] -z-10"></div>

              <div class="glass rounded-[24px] p-8 lg:p-10 relative overflow-hidden">
                <!-- Decorative corner -->
                <div class="absolute -top-8 -right-8 w-32 h-32 opacity-15 spin-slow">
                  <Decor variant="gold-flourish" class="w-full h-full" />
                </div>

                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="eyebrow text-[#A88842]">Módulo</p>
                    <p class="font-display leading-none text-transparent bg-clip-text bg-gradient-to-b from-[#E6CE94] via-[#C9A961] to-[#8B6F47] tabular-nums text-[clamp(2.75rem,9vw,5rem)]">{m.n}</p>
                  </div>
                  <div class="floaty shrink-0">
                    <Decor variant="almond" class="h-12 w-7 sm:h-16 sm:w-10 opacity-90" />
                  </div>
                </div>

                <div class="mt-5 sm:mt-6">
                  <p class="text-[11px] sm:text-[12px] uppercase tracking-[0.28em] text-[#8B6F47]">{m.label}</p>
                  <p class="font-display mt-1 text-[#2A2118] italic text-[clamp(1.15rem,3.8vw,1.625rem)] leading-tight">{m.title}</p>
                </div>

                <div class="mt-6 flex items-center gap-3">
                  <Decor variant="brush" class="flex-1 h-4 opacity-60" />
                  <span class="text-[11px] uppercase tracking-[0.22em] text-[#A88842]">7D</span>
                </div>
              </div>
            </div>

            <!-- Module text side -->
            <div class={`${i % 2 ? 'lg:[direction:ltr] lg:text-right' : ''}`}>
              <div class={`hidden lg:flex items-center ${i % 2 ? 'justify-end' : ''}`}>
                <!-- Indicator dot on timeline -->
                <div class={`absolute top-1/2 -translate-y-1/2 ${i % 2 ? 'left-1/2 -translate-x-1/2' : 'left-1/2 -translate-x-1/2'} z-10`}>
                  <div class="relative w-4 h-4">
                    <div class="absolute inset-0 rounded-full bg-[#C9A961]/40 blur-sm pulse-glow"></div>
                    <div class="relative w-4 h-4 rounded-full bg-gradient-to-br from-[#E6CE94] to-[#A88842] border-2 border-[#FAF6EE]"></div>
                  </div>
                </div>
              </div>

              <p class="eyebrow text-[#A88842]">{m.label}</p>
              <h3 class="font-display mt-3 text-[#2A2118] leading-tight text-[clamp(1.4rem,5vw,2.25rem)]">
                {m.title}
              </h3>
              <p class="mt-4 sm:mt-5 text-[#4A3D2C] text-[14.5px] lg:text-[16px] leading-[1.8]">
                {m.desc}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-20 lg:mt-28 text-center reveal">
      <a href="#oferta" class="btn-premium">
        <span>Quero começar no mercado de unhas</span>
        <svg viewBox="0 0 24 24" class="h-3 w-3 fill-none stroke-current" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>
