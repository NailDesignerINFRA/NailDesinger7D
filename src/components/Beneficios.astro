---
import Decor from "./Decor.astro";
---

<section id="beneficios" class="relative isolate overflow-hidden py-24 lg:py-36">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="orb orb-champagne" style="width: 520px; height: 520px; top: 20%; left: -150px;" data-parallax="0.06"></div>
    <div class="orb orb-gold" style="width: 360px; height: 360px; bottom: 10%; right: -100px; opacity: 0.55;" data-parallax="-0.04"></div>
  </div>

  <div class="mx-auto max-w-[1240px] px-6 lg:px-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <p class="micro-label reveal text-[#A88842]">Sua transformação em 7 dias</p>
      <h2 class="headline-lg mt-4 reveal reveal-delay-1 text-[#2A2118]">
        Em até <span class="shimmer-text font-medium italic">7 dias</span> você pode:
      </h2>
      <div class="mt-8 flex justify-center reveal reveal-delay-2">
        <Decor variant="brush" class="w-48 h-6" />
      </div>
    </div>

    <!-- Cards grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
      {[
        { n: "01", t: "Entender a base completa", d: "Toda a fundamentação da técnica Molde F1, do conceito à execução.", h: 200 },
        { n: "02", t: "Comprar com inteligência", d: "Saber exatamente quais materiais comprar — sem gastar dinheiro à toa.", h: 220 },
        { n: "03", t: "Acabamento natural", d: "Realizar aplicações com acabamento natural, leve e elegante.", h: 200 },
        { n: "04", t: "Confiança para praticar", d: "Ganhar confiança suficiente para começar a praticar todos os dias.", h: 220 },
        { n: "05", t: "Primeiros atendimentos", d: "Começar seus primeiros atendimentos e construir reputação local.", h: 200 },
        { n: "06", t: "Habilidade em renda", d: "Desenvolver uma habilidade que pode se transformar em renda.", h: 220 },
      ].map((item, i) => (
        <article
          class={`reveal reveal-delay-${(i % 4) + 1} group relative glass rounded-[22px] p-7 lg:p-8 overflow-hidden transition-all duration-700 hover:-translate-y-1 hover:shadow-[0_24px_60px_-20px_rgba(168,136,66,0.35)]`}
        >
          <!-- Hover glow -->
          <div class="absolute inset-0 bg-gradient-to-br from-[#F4E4C1]/0 via-[#F4E4C1]/0 to-[#E6CE94]/0 group-hover:from-[#F4E4C1]/30 group-hover:to-[#E6CE94]/20 transition-all duration-700 pointer-events-none"></div>

          <!-- Top decoration -->
          <div class="absolute -top-6 -right-6 w-24 h-24 opacity-10 group-hover:opacity-25 transition-opacity duration-700">
            <Decor variant="almond-outline" class="w-full h-full" />
          </div>

          <div class="relative flex items-center justify-between">
            <span class="font-display leading-none text-transparent bg-clip-text bg-gradient-to-b from-[#E6CE94] to-[#A88842] tabular-nums text-[clamp(2rem,7vw,2.75rem)]">{item.n}</span>
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-[#C9A961] opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-500" stroke-width="1.2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </div>

          <h3 class="relative font-display mt-4 sm:mt-5 text-[#2A2118] leading-tight text-[clamp(1.2rem,4vw,1.5rem)]">{item.t}</h3>
          <p class="relative mt-3 text-[14px] sm:text-[14.5px] text-[#5C4A30] leading-[1.7]">{item.d}</p>

          <div class="relative mt-6 pt-5 border-t border-[#C9A961]/20">
            <span class="text-[11px] uppercase tracking-[0.24em] text-[#8B6F47]">7D · Etapa</span>
          </div>
        </article>
      ))}
    </div>

    <!-- Editorial closing -->
    <div class="mt-20 lg:mt-28 max-w-3xl mx-auto text-center">
      <div class="space-y-5 text-[15px] sm:text-[16px] lg:text-[18px] leading-[1.8] text-[#4A3D2C] reveal">
        <p class="font-display text-[#2A2118] italic text-[clamp(1.25rem,4vw,1.625rem)]">
          Imagine conseguir fazer suas primeiras aplicações…
        </p>
        <p>Ver pessoas elogiando seu trabalho…</p>
        <p>Começar a atender suas primeiras clientes…</p>
        <p class="text-[#5C4A30]">
          E perceber que uma habilidade que parecia impossível pode se transformar em uma <em class="text-[#8B6F47] not-italic font-medium">nova fonte de renda</em> para você.
        </p>
        <p class="pt-3 font-display italic text-[#8B6F47] text-[clamp(1.25rem,4vw,1.625rem)]">
          Tudo isso começando pela técnica certa.
        </p>
      </div>

      <div class="mt-12 reveal reveal-delay-2">
        <a href="#oferta" class="btn-premium">
          <span>Quero começar no mercado de unhas</span>
          <svg viewBox="0 0 24 24" class="h-3 w-3 fill-none stroke-current" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>
