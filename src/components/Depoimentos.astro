---
import Decor from "./Decor.astro";

/**
 * Para trocar/adicionar depoimentos basta editar o array abaixo
 * e colocar os arquivos correspondentes em /public/depoimentos/.
 *
 *   type: "image" | "video"
 *   src:  nome do arquivo dentro de /public/depoimentos/
 */
const testimonials = [
  { type: "image", src: "01.png" },
  { type: "image", src: "02.png" },
  { type: "image", src: "03.png" },
  { type: "image", src: "04.png" },
  { type: "image", src: "05.png" },
  { type: "image", src: "06.png" },
  { type: "image", src: "07.png" },
  { type: "image", src: "08.png" },
  { type: "image", src: "09.png" },
] as const;

// Duplicamos a lista para o loop infinito ser contínuo
const loop = [...testimonials, ...testimonials];
---

<section id="depoimentos" class="relative isolate overflow-hidden py-28 lg:py-40 bg-[#FAF6EE]">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="orb orb-champagne" style="width: 600px; height: 600px; top: 10%; right: -150px;" data-parallax="0.04"></div>
    <div class="orb orb-gold" style="width: 380px; height: 380px; bottom: 10%; left: -100px; opacity: 0.5;" data-parallax="-0.05"></div>
  </div>

  <div class="mx-auto max-w-[1340px]">
    <div class="text-center px-6 mb-12 lg:mb-16">
      <p class="micro-label reveal text-[#A88842]">Quem já entrou está dizendo</p>
      <h2 class="headline-lg mt-5 reveal reveal-delay-1 text-[#2A2118] max-w-[22ch] mx-auto">
        Veja o que algumas
        <span class="italic font-light text-[#8B6F47]">alunas</span>
        estão dizendo
      </h2>

      <div class="mt-7 flex justify-center reveal reveal-delay-2">
        <Decor variant="brush" class="w-48 h-6 opacity-70" />
      </div>
    </div>

    <!-- Marquee infinito -->
    <div class="marquee reveal" aria-label="Carrossel de depoimentos">
      <div class="marquee-track">
        {loop.map((t, i) => (
          <article class="marquee-item group" aria-hidden={i >= testimonials.length ? "true" : undefined}>
            <div class="marquee-frame">
              <!-- Pérola decorativa -->
              <div class="absolute top-2 right-2 z-10">
                <Decor variant="pearl" class="w-3 h-3 opacity-80" />
              </div>

              <div class="testimonial-media relative w-full h-full overflow-hidden rounded-[14px] bg-[#F1E2D2]">
                {t.type === "image" ? (
                  <img
                    src={`/depoimentos/${t.src}`}
                    alt=""
                    class="absolute inset-0 w-full h-full object-cover"
                    width="540"
                    height="960"
                    loading="lazy"
                    decoding="async"
                    onerror="this.closest('.testimonial-media').classList.add('media-missing'); this.remove();"
                  />
                ) : (
                  <video
                    src={`/depoimentos/${t.src}`}
                    class="absolute inset-0 w-full h-full object-cover"
                    muted
                    loop
                    playsinline
                    autoplay
                    preload="metadata"
                    onerror="this.closest('.testimonial-media').classList.add('media-missing'); this.remove();"
                  ></video>
                )}

                <!-- Fallback se o arquivo faltar -->
                <div class="media-fallback absolute inset-0 hidden flex-col items-center justify-center gap-2 p-4 text-center">
                  <div class="h-10 w-10 rounded-full glass flex items-center justify-center border border-[#C9A961]/40">
                    <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-[#5C4A30]" stroke-width="1.4" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="9" cy="9" r="2"/>
                      <path d="M3 17l5-5 4 4 3-3 6 6"/>
                    </svg>
                  </div>
                  <p class="text-[10px] uppercase tracking-[0.2em] text-[#8B6F47]">/depoimentos/{t.src}</p>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .marquee {
    --marquee-duration: 70s;
    --marquee-gap: 18px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
    padding: 8px 0 20px;
  }

  .marquee-track {
    display: flex;
    gap: var(--marquee-gap);
    width: max-content;
    animation: marquee-scroll var(--marquee-duration) linear infinite;
    will-change: transform;
  }

  /* Desacelera em hover/focus em vez de pausar */
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-duration: calc(var(--marquee-duration) * 3.5);
  }

  .marquee-item {
    flex: 0 0 auto;
    width: clamp(180px, 24vw, 260px);
    aspect-ratio: 9 / 16;
  }

  .marquee-frame {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 6px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(255, 254, 251, 0.85) 0%, rgba(244, 228, 193, 0.45) 100%);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid rgba(201, 169, 97, 0.22);
    box-shadow: 0 10px 30px -16px rgba(92, 74, 48, 0.25);
    transition: transform 500ms var(--ease-premium), box-shadow 500ms var(--ease-premium);
  }

  .marquee-item:hover .marquee-frame {
    transform: translateY(-3px);
    box-shadow: 0 18px 50px -22px rgba(168, 136, 66, 0.5);
  }

  .testimonial-media.media-missing .media-fallback {
    display: flex;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-50% - var(--marquee-gap) / 2)); }
  }

  @media (max-width: 639px) {
    .marquee {
      --marquee-duration: 55s;
      --marquee-gap: 12px;
    }
    .marquee-item {
      width: clamp(160px, 56vw, 220px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
